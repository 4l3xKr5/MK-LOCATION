---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---
<Layout title="Page introuvable" description="Retrouvez le matériel MK Location ou préparez votre demande de location." noindex><section class="container error-page"><span class="error-number" aria-hidden="true">404</span><p class="eyebrow"><span class="signal-square"></span> Cette page n’est pas à disposition</p><h1>REPRENONS<br />LE BON CHEMIN.</h1><p>La page recherchée n’existe pas ou a changé d’adresse.</p><div class="error-actions"><Button href="/location">Voir le matériel</Button><Button href="/demande-location" variant="outline">Demander une location</Button></div></section></Layout>
