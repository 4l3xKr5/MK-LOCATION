---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import FAQ from '../components/FAQ.astro';
import Arrow from '../components/Arrow.astro';
const questions = [
  { question: 'Ma commune est-elle desservie ?', answer: 'MK intervient dans le secteur d’Annay et des alentours. Indiquez votre commune dans la demande pour vérifier les possibilités de livraison. Aucun rayon fixe n’est annoncé actuellement.' },
  { question: 'Quel est le prix de la livraison ?', answer: 'Les frais et les modalités sont précisés directement avec MK selon votre demande. Le tarif journalier du matériel ne permet pas de déduire le coût de livraison.' },
  { question: 'Puis-je louer sans livraison ?', answer: 'Cela peut être envisagé selon l’équipement et les conditions convenues avec MK. Il n’existe pas de dépôt de retrait annoncé pour un accès libre.' },
];
---
<Layout title="Livraison de matériel à Annay et alentours" description="MK Location organise principalement la mise à disposition par livraison. Indiquez votre commune autour d’Annay pour préciser les possibilités et modalités.">
  <section class="container page-heading"><p class="eyebrow"><span class="signal-square"></span> MK / Livraison & zone</p><h1>ON VOUS<br /><span class="text-outline">L’AMÈNE.</span></h1><p class="lead">Le bon matériel, au lieu convenu.<br />La mise à disposition s’organise avec vous.</p></section>
  <section class="container delivery-detail"><div class="territory-frame"><span class="eyebrow">Notre secteur</span><h2>ANNAY<span>.</span></h2><p>& alentours</p><div class="territory-route" aria-hidden="true"><span>MK</span><i></i><Arrow /><i></i><span>VOTRE PROJET</span></div><p class="territory-note">Votre commune, vos accès, votre besoin.<br />Les modalités se définissent ensemble.</p></div><div class="delivery-detail-copy"><h2>Une livraison<br />qui se prépare.</h2><p>MK fonctionne principalement par livraison chez le client ou sur le lieu d’utilisation. Le matériel et votre projet déterminent l’organisation à prévoir.</p><ul class="plain-checklist"><li>Le matériel souhaité</li><li>La commune de mise à disposition</li><li>La date et la durée envisagées</li><li>Les précisions utiles sur le lieu et ses accès</li></ul><Button href="/demande-location">Indiquer ma commune</Button></div></section>
  <section class="container section-pad faq-section"><div><p class="eyebrow">Les modalités</p><h2>ON PRÉCISE<br /><span class="text-outline">ENSEMBLE.</span></h2></div><FAQ items={questions} /></section>
</Layout>
