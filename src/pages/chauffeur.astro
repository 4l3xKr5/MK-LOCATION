---
import Layout from '../layouts/Layout.astro';
import EquipmentVisual from '../components/EquipmentVisual.astro';
import Button from '../components/Button.astro';
import RequestForm from '../components/RequestForm.astro';
import Contact from '../components/Contact.astro';
---
<Layout title="Porsche Panamera avec chauffeur" description="Découvrez la prestation Porsche Panamera avec chauffeur de MK Location. Précisez votre date, votre trajet et vos souhaits pour une proposition sur demande." dark>
  <section class="chauffeur-hero chauffeur-hero--editorial"><div class="container"><p class="eyebrow"><span class="signal-square"></span> MK / Chauffeur</p><h1>PORSCHE<br />PANAMERA<span>.</span><br /><span class="chauffeur-subtitle">AVEC CHAUFFEUR</span></h1><div class="chauffeur-hero-bottom"><p>Votre trajet.<br />Une autre dimension.</p><Button href="#demande" variant="light">Demander une prestation</Button></div><EquipmentVisual kind="car" slug="chauffeur" index="06" dark priority /></div></section>
  <section class="container section-pad chauffeur-intro"><div data-reveal="wipe"><p class="eyebrow">Une prestation à part entière</p><h2>LE VÉHICULE.<br />LE CHAUFFEUR.<br /><span class="text-outline">VOTRE TRAJET.</span></h2></div><div data-reveal="right" data-reveal-delay="1"><p class="lead">La Porsche Panamera est proposée avec chauffeur.</p><p>Décrivez votre trajet, vos dates et vos souhaits. MK précise avec vous les modalités de la prestation, selon votre demande.</p><dl class="product-facts"><div><dt>Prestation</dt><dd>Véhicule avec chauffeur</dd></div><div><dt>Tarif</dt><dd>Sur demande</dd></div><div><dt>Organisation</dt><dd>Sur accord avec MK</dd></div></dl></div></section>
  <section class="chauffeur-form-section" id="demande"><div class="container"><div class="section-heading"><div data-reveal="wipe"><p class="eyebrow"><span class="signal-square"></span> Préparons votre trajet</p><h2>OÙ ALLONS-NOUS ?</h2></div><p data-reveal="right" data-reveal-delay="1">Une première demande.<br />Les détails se précisent ensemble.</p></div><div class="form-layout chauffeur-form-layout"><div data-reveal><RequestForm kind="chauffeur" /></div><aside class="form-aside" data-reveal="right" data-reveal-delay="1"><Contact subject="une prestation Porsche Panamera avec chauffeur" compact /><p class="small-note">Cette demande concerne la Porsche avec chauffeur. Pour une mini-pelle avec chauffeur, utilisez le <a href="/demande-location?materiel=mini-pelle">formulaire de location de matériel</a>.</p></aside></div></div></section>
</Layout>
