---
import Layout from '../../layouts/Layout.astro';
import EquipmentVisual from '../../components/EquipmentVisual.astro';
import Button from '../../components/Button.astro';
import Contact from '../../components/Contact.astro';
import { equipment, money } from '../../data/catalog';
import { publication, site } from '../../config/site';
export function getStaticPaths() { return equipment.map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
const request = `/demande-location?materiel=${item.slug}`;
---
<Layout title={`Location ${item.name.toLowerCase()} à Annay et alentours`} description={`${item.description} Location courte et longue durée à Annay et alentours, livraison selon modalités convenues.`}>
  <section class="container product-heading"><nav class="breadcrumbs" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/location">Matériel</a><span aria-hidden="true">/</span><span aria-current="page">{item.name}</span></nav><div class="product-title-row"><p class="eyebrow">MK / {item.index} — {item.category}</p><span class="eyebrow">Annay & alentours</span></div><h1>{item.shortName}<span class="product-title-dot">.</span></h1></section>
  <section class="container product-main"><EquipmentVisual kind={item.visual} slug={item.slug} index={item.index} priority /><div class="product-summary"><p class="eyebrow">Courte & longue durée</p><h2>{item.need}</h2><p>{item.description}</p><div class="price-block"><span class="price-amount">{money(item.dailyRate)}<span>€</span></span><span class="price-unit">/ jour{publication.prices.taxLabel && <small>{publication.prices.taxLabel}</small>}</span></div>{site.preview && <p class="price-note">Tarif de référence du dossier. Base HT/TTC et modalités à confirmer avant publication.</p>}<dl class="product-facts"><div><dt>Caution</dt><dd>{item.deposit ? `${money(item.deposit)} €${item.driver ? ' sans chauffeur' : ''}` : 'À préciser avec MK'}</dd></div><div><dt>Livraison</dt><dd>Selon modalités convenues</dd></div>{item.driver && <div><dt>Formule</dt><dd>Avec ou sans chauffeur</dd></div>}</dl><Button href={request}>Demander {item.driver ? 'cette mini-pelle' : item.slug === 'betonniere' ? 'cette bétonnière' : item.slug === 'camion-benne' ? 'ce camion' : item.slug === 'utilitaire' ? 'cet utilitaire' : 'ce plateau'}</Button><p class="small-note">Disponibilité et conditions confirmées avec MK.</p></div></section>
  <section class="container product-details section-pad"><div><p class="eyebrow">Avant de vous lancer</p><h2>LE BON MATÉRIEL.<br />LES BONNES<br /><span class="text-outline">MODALITÉS.</span></h2></div><div class="detail-stack">{item.driver && <article><h3>Avec ou sans chauffeur.</h3><p>Vous pouvez demander la mini-pelle seule ou avec chauffeur. La caution documentée de 1 000 € concerne la location sans chauffeur.</p><p>{publication.prices.miniPelleDriverNote || 'La prestation avec chauffeur et son tarif doivent être précisés avec MK.'}</p></article>}<article><h3>Les caractéristiques à vérifier.</h3>{item.specs.length ? <dl class="product-facts">{item.specs.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl> : <p>Expliquez votre besoin à MK pour vérifier les dimensions, les capacités et les conditions d’utilisation du matériel.</p>}{item.slug === 'plateau-remorque-35t' && <p>La désignation « 3,5 t » du dossier ne précise pas la charge utile. Les caractéristiques et les conditions de transport sont à confirmer avant location.</p>}</article><article><h3>À la journée. Ou plus longtemps.</h3><p>MK propose la courte et la longue durée. Indiquez la durée envisagée : les conditions d’une location prolongée sont définies lors de l’échange.</p></article><article><h3>Au lieu convenu.</h3><p>La mise à disposition est principalement organisée par livraison, dans le secteur d’Annay et des alentours.</p><a class="text-link" href="/livraison-annay">Comprendre la livraison <span aria-hidden="true">↗</span></a></article></div></section>
  <section class="section-coal"><div class="container closing-cta"><p class="eyebrow">MK / On s’organise</p><h2>VOTRE PROJET<br />COMMENCE ICI.</h2><Button href={request}>Demander une location</Button></div></section>
  <section class="container section-pad"><Contact subject={`une location de ${item.name.toLowerCase()}`} compact /></section>
</Layout>
