---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import Arrow from './Arrow.astro';
import EquipmentVisual from './EquipmentVisual.astro';
import miniPelle from '../assets/equipment/mini-pelle-hero.png';
import { publication, site } from '../config/site';
import '../styles/hero-poster.css';

// This composition is an illustration, never a substitute for a verified fleet photo.
const useIllustration = site.preview && !publication.offerPhotos['mini-pelle']?.some((photo) => photo.verified);
---
<section class="hero poster-hero" aria-labelledby="hero-title">
  <div class="container poster-stage">
    <div class="poster-topline">
      <p class="eyebrow"><span class="signal-square"></span> Annay & alentours</p>
      <p class="mono">Location courte & longue durée</p>
    </div>

    <h1 id="hero-title" class="poster-title">
      <span class="poster-title-line"><span>MATÉRIEL.</span> <span>VÉHICULES.</span></span>
      <span class="poster-title-line">À DISPOSITION<span class="poster-period">.</span></span>
    </h1>

    <div class="poster-body">
      <div class="poster-copy">
        <span class="poster-rule" aria-hidden="true"></span>
        <p class="poster-lead">Le bon équipement.<br />Au lieu convenu.<br /> Pour votre projet.</p>
        <div class="poster-actions">
          <Button href="/demande-location" diagonal>Demander une location</Button>
          <a class="text-link" href="/location">Voir le matériel <Arrow /></a>
        </div>
      </div>

      <div class="poster-display">
        <div class="poster-plane" aria-hidden="true"></div>
        <div class="poster-frame" aria-hidden="true"></div>
        {useIllustration ? (
          <figure class="poster-machine" data-image-provenance="generated-illustration">
            <Picture src={miniPelle} alt="Mini-pelle jaune à chenilles, arceau noir et godet au sol — illustration."
              formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 768, 1200, 1536]}
              sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1624px) 58vw, 940px"
              loading="eager" fetchpriority="high" decoding="async" quality={85} />
          </figure>
        ) : <EquipmentVisual class="poster-verified" priority />}
        <a class="poster-equipment" href="/location/mini-pelle">
          <span class="mono">01 / TERRASSEMENT</span>
          <span class="poster-equipment-name">LA MINI-PELLE <Arrow diagonal /></span>
        </a>
      </div>
    </div>

    <div class="poster-footline">
      <p class="mono">Matériel de chantier <span aria-hidden="true">/</span> Véhicules & utilitaires</p>
      <p class="mono">Livraison selon modalités <Arrow diagonal /></p>
    </div>
  </div>
</section>
