---
import Arrow from './Arrow.astro';
interface Props { href: string; variant?: 'primary' | 'outline' | 'light'; class?: string; diagonal?: boolean }
const { href, variant = 'primary', class: className = '', diagonal = false } = Astro.props;
---
<a href={href} class:list={['button', `button--${variant}`, className]}><span><slot /></span><Arrow diagonal={diagonal} /></a>
