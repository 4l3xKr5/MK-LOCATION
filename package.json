{
  "name": "mk-location",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "start": "astro dev --host 127.0.0.1",
    "build": "node scripts/check-production.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "lint": "eslint .",
